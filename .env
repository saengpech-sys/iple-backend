# Development environment variables
ENV=test
PORT=8080
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000

# Database configuration (will fail to connect, but that's ok for testing the API structure)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=iple_lms_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Bangkok

# JWT configuration
JWT_SECRET_KEY=test_secret_key_for_development_only_please_change_in_production
JWT_EXPIRES_IN_MINUTES=60

# Graceful shutdown timeout
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=30